# Copy to .env and edit. SQLite works out of the box; PostgreSQL is recommended.
PROJECT_NAME="Project & Team Management API"
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pm_db
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin@12345
